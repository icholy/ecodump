---
// Decorative remembrance poppy used to flag the veteran-owned mentions.
// Inline SVG rather than an image file so it stays crisp at every size and
// costs no extra request. Always paired with visible "Veteran owned" text,
// so it is hidden from assistive tech.
interface Props {
  size?: number;
  class?: string;
}

const { size = 14, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
>
  <g fill="#c8102e">
    <circle cx="8.4" cy="8.4" r="5.2" />
    <circle cx="15.6" cy="8.4" r="5.2" />
    <circle cx="8.4" cy="15.6" r="5.2" />
    <circle cx="15.6" cy="15.6" r="5.2" />
  </g>
  <circle cx="12" cy="12" r="2.7" fill="#17202a" />
</svg>
